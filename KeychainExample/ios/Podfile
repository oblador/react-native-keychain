# Use RN 0.82 precompiled libraries; its source fmt dependency fails on newer Xcode.
# Set both variables to 0 to build React Native from source on a compatible Xcode.
ENV['RCT_USE_RN_DEP'] ||= '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

workspace 'KeychainExample.xcworkspace'

# React Native Test App generates the host's Info.plist during pod installation.
configure_test_host = proc do |installer|
  project = installer.aggregate_targets.find { |target| target.name == 'Pods-ReactTestApp' }.user_project
  path = project.path.dirname.join('Info.plist')
  info = Xcodeproj::Plist.read_from_path(path)
  info['NSFaceIDUsageDescription'] = 'Verify access to protected credentials in the Keychain example.'
  Xcodeproj::Plist.write_to_path(info, path)
end

use_test_app! :post_install => configure_test_host do |app|
  app.tests do
    pod 'KeychainNativeTests', :path => 'KeychainNativeTests'
  end
  app.ui_tests do
    pod 'KeychainUITests', :path => 'KeychainUITests'
  end
end
