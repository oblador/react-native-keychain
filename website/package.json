{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "typedoc --options typedoc.json",
    "start": "yarn api && vitepress dev . --host 127.0.0.1",
    "build": "yarn api && vitepress build . && node scripts/redirects.mjs && node scripts/check-links.mjs",
    "serve": "vitepress preview . --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typedoc": "^0.26.7",
    "typedoc-plugin-markdown": "^4.2.8",
    "typescript": "~5.6.3",
    "vitepress": "1.6.4",
    "vue": "3.5.30"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
